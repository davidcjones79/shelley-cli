[Unit]
Description=Igor - Shelley File Transfer Assistant
After=network.target

[Service]
Type=exec
User=exedev
Group=exedev
WorkingDirectory=/home/exedev
ExecStart=/usr/local/bin/shelley igor -port 8001
Restart=on-failure
RestartSec=5
Environment=HOME=/home/exedev
Environment=USER=exedev

StandardOutput=journal
StandardError=journal
SyslogIdentifier=igor

[Install]
WantedBy=multi-user.target
